---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import Sidebar from '../components/Sidebar.astro';
import ShareButtons from '../components/ShareButtons.astro';
import AdSlot from '../components/AdSlot.astro';
import { getPosts, formatDate, readingTime, slugifyTag, type Post } from '../lib/posts';
import { SITE, CATEGORIES, type CategoryKey } from '../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, all: posts },
  }));
}

interface Props {
  post: Post;
  all: Post[];
}

const { post, all } = Astro.props;
const { title, description, date, updated, category, tags, image, imageAlt, sourceUrl, faqs } = post.data;
const { Content } = await render(post);
const cat = CATEGORIES[category as CategoryKey];
const url = new URL(`/${post.id}`, SITE.url).href;
const minutes = readingTime(post.body);

const related = all
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    p,
    score: (p.data.category === category ? 2 : 0) + p.data.tags.filter((t) => tags.includes(t)).length,
  }))
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score || b.p.data.date.valueOf() - a.p.data.date.valueOf())
  .slice(0, 3)
  .map((r) => r.p);

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    image: new URL(image, SITE.url).href,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    author: { '@type': 'Person', name: SITE.author.name, url: new URL('/about', SITE.url).href },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: cat.name, item: new URL(`/category/${category}`, SITE.url).href },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
if (faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  publishedTime={date.toISOString()}
  modifiedTime={(updated ?? date).toISOString()}
  jsonLd={jsonLd}
>
  <nav class="container breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span class="sep">•</span><a href={`/category/${category}`}>{cat.name}</a>
  </nav>

  <div class="container layout" style="padding-top: 0">
    <article class="post">
      <header class="post-header">
        <a class="kicker" href={`/category/${category}`}>{cat.name}</a>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <div class="byline">
          <span>By <a href="/about"><strong>{SITE.author.name}</strong></a></span>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {updated && <span>Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
          <span>{minutes} min read</span>
        </div>
      </header>

      <img class="post-hero" src={image} alt={imageAlt} width="1200" height="630" loading="eager" fetchpriority="high" />

      <AdSlot />

      <div class="prose">
        <Content />
      </div>

      {faqs.length > 0 && (
        <section class="faqs">
          <h2>Frequently asked questions</h2>
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}

      {sourceUrl && (
        <aside class="source-box">
          <strong>Official source:</strong>{' '}
          <a href={sourceUrl} rel="noopener nofollow" target="_blank">{new URL(sourceUrl).hostname}</a>
          <p class="small muted">Dates and details can change. Always confirm on the official page before applying or paying any fee.</p>
        </aside>
      )}

      <ShareButtons url={url} title={title} />

      {tags.length > 0 && (
        <p class="tags">
          {tags.map((t) => <a href={`/tag/${slugifyTag(t)}`} class="tag">#{t}</a>)}
        </p>
      )}

      <aside class="author-box">
        <div class="avatar" aria-hidden="true">{SITE.author.name.charAt(0)}</div>
        <div>
          <strong>{SITE.author.name}</strong>
          <p>{SITE.author.bio}</p>
          <p class="small"><a href="/about">More about us</a> · <a href="/editorial-policy">How we check facts</a></p>
        </div>
      </aside>

      {related.length > 0 && (
        <section class="block related">
          <div class="block-head"><h2>Related posts</h2><a href={`/category/${category}`}>More in {cat.name} »</a></div>
          <ul class="rows">{related.map((p) => <PostRow post={p} />)}</ul>
        </section>
      )}
    </article>

    <Sidebar exclude={post.id} />
  </div>
</BaseLayout>
