---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBar from '../../components/SectionBar.astro';
import PostRow from '../../components/PostRow.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getPosts, slugifyTag } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tags.set(slugifyTag(t), t)));
  return [...tags].map(([tag, label]) => ({
    params: { tag },
    props: { label, posts: posts.filter((p) => p.data.tags.some((t) => slugifyTag(t) === tag)) },
  }));
}

const { label, posts } = Astro.props;

// Longest wording that keeps the full title (with the site name added) at 60 characters or less.
const title =
  [
    `${label}: Latest News, Updates and Explainers`,
    `${label}: Latest News, Updates and Guides`,
    `${label}: Latest News and Updates`,
  ].find((t) => t.length <= 50) ?? `${label}: Latest News and Updates`;
---

<!-- Tag pages are thin lists, so keep them out of Google's index. -->
<BaseLayout
  {title}
  description={`All Dishalu posts tagged ${label}: the latest news, updates and explainers, checked against official sources and listed newest first.`}
  noindex
>
  <SectionBar title={`#${label}`} crumbs={[{ href: '#', label: `#${label}` }]} />
  <div class="container layout">
    <div><ul class="rows">{posts.map((p) => <PostRow post={p} />)}</ul></div>
    <Sidebar />
  </div>
</BaseLayout>
