---
import type { Post } from '../lib/posts';
import { formatDate, thumb } from '../lib/posts';
import { CATEGORIES, type CategoryKey } from '../site.config';

interface Props {
  post: Post;
  showCategory?: boolean; // false on a category page, where every post has the same category
}
const { post, showCategory = true } = Astro.props;
const { title, description, date, category, image, imageAlt } = post.data;
const cat = CATEGORIES[category as CategoryKey];
---

<li class="row">
  <a href={`/${post.id}`} tabindex="-1" aria-hidden="true">
    <img
      src={thumb(image)}
      srcset={`${thumb(image, 320)} 320w, ${thumb(image)} 480w`}
      sizes="(max-width: 640px) 92px, 240px"
      alt={imageAlt}
      width="480"
      height="252"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div>
    <h3><a href={`/${post.id}`}>{title}</a></h3>
    <div class="row-meta">
      {showCategory && <a class="pill" href={`/category/${category}`} style={`color:${cat.color};background:${cat.soft}`}>{cat.name}</a>}
      <time class="date" datetime={date.toISOString()}>{formatDate(date)}</time>
    </div>
    <p>{description}</p>
  </div>
</li>
