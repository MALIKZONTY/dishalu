---
interface Props {
  title: string;
  subtitle?: string;
  icon?: string;
  crumbs?: { href: string; label: string }[];
}
const { title, subtitle, icon, crumbs = [] } = Astro.props;
---

<div class="section-bar">
  <div class="container">
    <h1 class:list={[{ "with-icon": icon }]}>{icon && <img src={icon} alt={`${title} icon`} width="40" height="40" />}{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</div>
{crumbs.length > 0 && (
  <nav class="container breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    {crumbs.map((c, i) => (
      <>
        <span class="sep">•</span>
        {i === crumbs.length - 1 ? <span>{c.label}</span> : <a href={c.href}>{c.label}</a>}
      </>
    ))}
  </nav>
)}
