---
// Renders nothing until SITE.adsenseClient is set. After approval you can
// either rely on Auto ads (no slot ids needed) or paste a slot id here.
import { SITE } from '../site.config';
interface Props {
  slot?: string;
}
const { slot } = Astro.props;
---

{SITE.adsenseClient && slot && (
  <div class="ad">
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={SITE.adsenseClient}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    />
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
