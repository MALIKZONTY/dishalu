---
import { SITE, ACTIVE_CATEGORIES } from '../site.config';
import { getPosts } from '../lib/posts';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const path = Astro.url.pathname.replace(/\.html$/, '');
const links = [
  { href: '/', label: 'Home', active: path === '/' || path === '/index' },
  ...Object.entries(ACTIVE_CATEGORIES).map(([key, cat]) => ({
    href: `/category/${key}`,
    label: cat.name,
    active: path.startsWith(`/category/${key}`),
  })),
  { href: '/archive', label: 'All Posts', active: path.startsWith('/archive') },
];
const newest = (await getPosts())[0];
---

<div class="top-strip">
  <img src="/icons/3d/bell.webp" alt="" width="18" height="18" class="strip-icon" />
  {newest ? (
    <a href={`/${newest.id}`}><strong class="strip-label">Latest:</strong> {newest.data.title}</a>
  ) : (
    <a href="/archive">{SITE.tagline}</a>
  )}
  <Icon name="chevron" size={16} class="strip-icon" />
  {SITE.social.telegram && (
    <span class="strip-extra"> · <a href={SITE.social.telegram} rel="noopener" target="_blank">Join our Telegram</a></span>
  )}
</div>

<header class="site-header">
  <div class="container header-row">
    <Logo />
    <nav class="main-nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="search-btn" href="/search" aria-label="Search">
      <Icon name="search" size={20} />
      <span>Search</span>
    </a>
  </div>
</header>
