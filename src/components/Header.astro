---
import { SITE, ACTIVE_CATEGORIES, TOP_STRIP } from '../site.config';
import { getPosts } from '../lib/posts';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const path = Astro.url.pathname.replace(/\.html$/, '');
const links = [
  { href: '/', label: 'Home', active: path === '/' || path === '/index' },
  ...Object.entries(ACTIVE_CATEGORIES).map(([key, cat]) => ({
    href: `/category/${key}`,
    label: cat.name,
    active: path.startsWith(`/category/${key}`),
  })),
  { href: '/archive', label: 'All Posts', active: path.startsWith('/archive') },
];
const posts = await getPosts();
const pinned = TOP_STRIP.slug ? posts.find((p) => p.id === TOP_STRIP.slug) : undefined;
const stripPost = pinned ?? posts[0];
const stripLabel = pinned ? TOP_STRIP.label : 'Latest';
---

<div class="top-strip">
  <img src="/icons/3d/bell.webp" alt="" width="18" height="18" class="strip-icon strip-bell" />
  {stripPost ? (
    <a href={`/${stripPost.id}`} class="strip-link">{stripLabel && <strong class="strip-label">{stripLabel}:</strong>} {stripPost.data.title}</a>
  ) : (
    <a href="/archive" class="strip-link">{SITE.tagline}</a>
  )}
  <Icon name="chevron" size={16} class="strip-icon" />
  {SITE.social.telegram && (
    <span class="strip-extra"> · <a href={SITE.social.telegram} rel="noopener" target="_blank">Join our Telegram</a></span>
  )}
</div>

<header class="site-header">
  <div class="container header-row">
    <Logo />
    <nav class="main-nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="search-btn" href="/search" aria-label="Search">
      <Icon name="search" size={20} />
      <span>Search</span>
    </a>
  </div>
</header>
